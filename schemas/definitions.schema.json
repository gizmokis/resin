{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gizmokis/resin/refs/heads/master/schemas/definitions.schema.json",
  "title": "Definitions for Resin JSON schemas",
  "description": "Common definitions for Resin JSON schemas used by prefabs and scenes.",
  "$defs": {
    "intId": {
      "type": "integer",
      "minimum": 0
    },
    "binaryOperation": {
      "type": "string",
      "enum": [
        "union",
        "smoothUnion",
        "diff",
        "smoothDiff",
        "inter",
        "smoothInter",
        "xor",
        "smoothXor"
      ]
    },
    "factor": {
      "type": "number",
      "minimum": 0
    },
    "color": {
      "type": "object",
      "description": "Color in RGB format",
      "required": [
        "r",
        "g",
        "b"
      ],
      "additionalProperties": false,
      "properties": {
        "r": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Red component"
        },
        "g": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Green component"
        },
        "b": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Blue component"
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "rotation",
        "scale"
      ],
      "properties": {
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z",
            "w"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "w": {
              "type": "number"
            }
          }
        },
        "scale": {
          "type": "number"
        }
      }
    },
    "attenuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constant",
        "linear",
        "quadratic"
      ],
      "properties": {
        "constant": {
          "type": "number",
          "minimum": 0.0
        },
        "linear": {
          "type": "number",
          "minimum": 0.0
        },
        "quadratic": {
          "type": "number",
          "minimum": 0.0
        }
      }
    },
    "lightCommon": {
      "type": "object",
      "required": [
        "color",
        "transform",
        "name"
      ],
      "properties": {
        "color": {
          "$ref": "#/$defs/color"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "directionalLight": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/lightCommon"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ambient_impact"
          ],
          "properties": {
            "ambientImpact": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.0
            }
          }
        }
      ]
    },
    "pointLight": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/lightCommon"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "attenuation"
          ],
          "properties": {
            "attenuation": {
              "$ref": "#/$defs/attenuation"
            }
          }
        }
      ]
    },
    "light": {
      "oneOf": [
        {
          "$ref": "#/$defs/pointLight"
        },
        {
          "$ref": "#/$defs/directionalLight"
        }
      ]
    },
    "nodeCommon": {
      "type": "object",
      "required": [
        "binaryOperation",
        "factor",
        "name",
        "transform"
      ],
      "properties": {
        "binaryOperation": {
          "$ref": "#/$defs/binaryOperation"
        },
        "factor": {
          "$ref": "#/$defs/factor"
        },
        "name": {
          "type": "string"
        },
        "materialId": {
          "$ref": "#/$defs/intId"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        }
      }
    },
    "primitive": {
      "type": "object",
      "required": [
        "typeId"
      ],
      "properties": {
        "typeId": {
          "type": [
            "number",
            "null"
          ]
        },
        "params": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "primitiveNode": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/nodeCommon"
        },
        {
          "type": "object",
          "required": [
            "primitive"
          ],
          "properties": {
            "sphere": {
              "$ref": "#/$defs/primitive"
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "groupNode": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/nodeCommon"
        },
        {
          "type": "object",
          "required": [
            "group"
          ],
          "properties": {
            "group": {
              "$ref": "#/$defs/group"
            }
          }
        }
      ]
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/groupNode"
        },
        {
          "$ref": "#/$defs/primitiveNode"
        }
      ]
    },
    "material": {
      "type": "object",
      "description": "Phong material properties",
      "required": [
        "id",
        "name",
        "albedo",
        "ambient",
        "diffuse",
        "specular",
        "specularExponent"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/intId"
        },
        "name": {
          "type": "string"
        },
        "albedo": {
          "$ref": "#/$defs/color"
        },
        "ambient": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Ambient light reflection factor"
        },
        "diffuse": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Diffuse light reflection factor"
        },
        "specular": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Specular light reflection factor"
        },
        "specularExponent": {
          "type": "number",
          "minimum": 0,
          "description": "Specular exponent (shininess)"
        }
      }
    },
    "primitiveType": {
      "type": "object",
      "required": [
        "typeId",
        "sdfCodeContent"
      ],
      "properties": {
        "typeId": {
          "type": "number"
        },
        "sdfCodeContent": {
          "type": "string"
        }
      }
    },
    "primitiveTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/primitiveType"
      }
    },
    "tree": {
      "type": "object",
      "required": [
        "rootGroup"
      ],
      "properties": {
        "materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/material"
          }
        },
        "rootGroup": {
          "$ref": "#/$defs/groupNode"
        },
        "primitiveTypes": {
          "$ref": "#/$defs/primitiveTypes"
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "tree"
      ],
      "properties": {
        "tree": {
          "$ref": "#/$defs/tree"
        },
        "lights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/light"
          }
        }
      }
    }
  }
}
